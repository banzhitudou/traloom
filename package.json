{
  "name": "traloom",
  "version": "0.2.2",
  "description": "Traloom - AI 辅助图书翻译工作台",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "node scripts/run-vite.cjs dev",
    "app:mac": "npm run build && node scripts/launch-built.cjs",
    "package:mac:local": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dir --arm64 -c.electronDist=node_modules/electron/dist -c.directories.output=dist/local -c.npmRebuild=false && xattr -cr 'dist/local/mac-arm64/Traloom.app' && codesign --force --deep --sign - 'dist/local/mac-arm64/Traloom.app'",
    "build": "node scripts/run-vite.cjs build",
    "preview": "node scripts/run-vite.cjs preview",
    "start": "node scripts/run-vite.cjs preview",
    "typecheck:node": "node_modules/.bin/tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "node_modules/.bin/tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:all": "npm run build && electron-builder -mwl"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "docx": "^9.5.1",
    "lucide-react": "^1.51.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.22.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^33.4.11",
    "electron-builder": "^25.0.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.41",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.10",
    "typescript": "~5.5",
    "vite": "^5.4.0",
    "vitest": "^2.0.5",
    "zustand": "^4.5.5"
  }
}
